# Where Vite sends /api/v1 in development: "mock" (Prism on port 4010, built
# from apps/api/openapi/v1.yaml) or "laravel" (php artisan serve on port 8000).
VITE_API_TARGET=mock
MOCK_API_URL=http://127.0.0.1:4010
LARAVEL_API_URL=http://127.0.0.1:8000

# Set only when the API is served from another origin in production.
# VITE_API_BASE_URL=https://api.example.sa/api/v1
