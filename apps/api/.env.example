APP_NAME=GroupBuy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

# APP_MAINTENANCE_STORE=database

# Comma-separated IPs or CIDR ranges of the load balancer in front of the API.
# TRUSTED_PROXIES=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# With LOG_STACK=stderr: Monolog\Formatter\JsonFormatter writes one JSON
# object per line, for a log platform (production does; deploy/env).
# LOG_STDERR_FORMATTER=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=groupbuy
DB_USERNAME=groupbuy
DB_PASSWORD=groupbuy

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live campaign progress. "reverb" sends each change to Laravel Reverb
# (apps/realtime), which pushes it to the website and the app; "log" writes
# it to the log, and the pages poll every 5 seconds instead. The app ID, key
# and secret match apps/realtime/.env. REVERB_HOST/PORT/SCHEME are where the
# API posts events: in production Reverb's private address (see
# apps/realtime/README.md), not the public wss:// host the clients use.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sign-in codes and customer messages. "unifonic" or "taqnyat" send real SMS;
# "log" writes them to the log (local and staging only; it refuses to send in
# production). SMS_SENDER is the approved sender name (Taqnyat needs it).
SMS_DRIVER=log
SMS_SENDER=
UNIFONIC_APP_SID=
TAQNYAT_TOKEN=

# Push messages to the mobile app. "expo" sends through Expo's push service
# (the app registers Expo push tokens); "log" writes them to the log and
# refuses to send in production. EXPO_ACCESS_TOKEN only if enhanced push
# security is on in the Expo project.
PUSH_DRIVER=log
EXPO_ACCESS_TOKEN=

# Product photos (public) and supplier quote files (private, shown through
# 30-minute signed links). Local disks until S3-compatible storage is set up;
# then MEDIA_DISK=s3-media and DOCUMENTS_DISK=s3-documents with the AWS_*
# settings below. AWS_MEDIA_URL is the public base URL of a CDN; leave it
# blank to use the bucket's own URL.
MEDIA_DISK=public
DOCUMENTS_DISK=local

# Card holds. "fake" stands in for Moyasar until the merchant account is
# approved (it refuses to run in production). WEB_URL is the customer website,
# where the payment form sends customers back (/payments/return).
MOYASAR_DRIVER=fake
MOYASAR_PUBLISHABLE_KEY=pk_test_fake
# With MOYASAR_DRIVER=moyasar: the secret key from the Moyasar dashboard. It and
# MOYASAR_PUBLISHABLE_KEY must be a test pair (sk_test_, pk_test_), or a live pair
# (sk_live_, pk_live_) in production. Never commit the secret key.
MOYASAR_SECRET_KEY=
# The secret token set on the webhook in the Moyasar dashboard. Empty refuses every webhook.
MOYASAR_WEBHOOK_SECRET=
WEB_URL=http://localhost:3000

# Courier for the last mile. "manual": staff enter the courier's tracking
# number and updates by hand. "fake": books parcels and moves them along
# without a network call (refuses to run in production). "aramex": books
# through Aramex and reads tracking every 30 minutes; check it against the
# sandbox first (ARAMEX_BASE_URL=https://ws.sbx.aramex.net).
COURIER_DRIVER=manual
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=RUH
# The warehouse parcels leave from, printed on courier bookings.
# WAREHOUSE_CONTACT_NAME=
# WAREHOUSE_PHONE=
# WAREHOUSE_EMAIL=
# WAREHOUSE_ADDRESS_LINE1=
# WAREHOUSE_ADDRESS_LINE2=
# WAREHOUSE_CITY=Riyadh
# WAREHOUSE_POSTAL_CODE=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_MEDIA_BUCKET=
AWS_MEDIA_URL=
AWS_DOCUMENTS_BUCKET=
# Only for S3-compatible storage other than AWS (set path-style to true if it needs it).
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Error tracking. Empty sends nothing. Request bodies, cookies, IPs, query
# strings, SQL values and phone numbers are never sent (App\Support\SentryScrubber).
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1


# Business rules (see config/groupbuy.php). Defaults match the agreed decisions.
# GROUPBUY_MIN_MARGIN_BP=1500
# GROUPBUY_RESERVATION_MINUTES=15

# Seller of record on VAT invoices (from the CR and VAT certificate, E1).
# In production nothing is captured until the names and VAT number are set.
# GROUPBUY_SELLER_NAME_AR=
# GROUPBUY_SELLER_NAME_EN=
# GROUPBUY_SELLER_VAT_NUMBER=
# GROUPBUY_SELLER_CR_NUMBER=
# GROUPBUY_SELLER_ADDRESS_AR=
# GROUPBUY_SELLER_ADDRESS_EN=
# The national address in parts, for e-invoices (ZATCA phase 2).
# GROUPBUY_SELLER_STREET=
# GROUPBUY_SELLER_BUILDING_NUMBER=
# GROUPBUY_SELLER_DISTRICT=
# GROUPBUY_SELLER_CITY=Riyadh
# GROUPBUY_SELLER_POSTAL_CODE=

# ZATCA e-invoicing phase 2: sign every invoice and report it to Fatoora.
# Onboard first: php artisan zatca:onboard --otp=<OTP from the Fatoora portal>
# ZATCA_ENABLED=false
# ZATCA_ENV=simulation
# ZATCA_SOLUTION_NAME=GroupBuy
# ZATCA_EGS_MODEL=API
# ZATCA_ORGANIZATION_UNIT=Main Branch
# ZATCA_LOCATION=Riyadh
# ZATCA_INDUSTRY=Retail
