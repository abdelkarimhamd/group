# Copy to .env.local and adjust. Values prefixed EXPO_PUBLIC_ are baked into the app bundle,
# so never put secrets here.

# API base URL. Leave unset to use the Prism mock on port 4010 of the machine running Metro.
# Laravel locally: http://localhost:8000/api/v1 (Android emulator: http://10.0.2.2:8000/api/v1)
# EXPO_PUBLIC_API_URL=http://localhost:4010

# Privacy policy page shown before the first join.
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.sa/privacy
