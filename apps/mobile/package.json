{
  "name": "@groupbuy/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "^5.105.1",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.7.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "mock": "prism mock ../api/openapi/v1.yaml -p 4010 -h 0.0.0.0",
    "api:types": "openapi-typescript ../api/openapi/v1.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "api:types:check": "node scripts/check-api-types.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:contract": "node scripts/contract-test.mjs",
    "bundle:check": "expo export --platform ios --platform android --output-dir dist-check && rm -rf dist-check"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
