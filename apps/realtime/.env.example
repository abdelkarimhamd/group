# Laravel Reverb for live campaign progress. The app ID, key and secret are
# the same values as REVERB_APP_ID/KEY/SECRET in apps/api/.env; the website
# and the app get only the key.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Where this process listens. In production the load balancer ends TLS on
# the public wss:// host and forwards WebSocket upgrades here.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# The public address the website and app connect to.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Comma-separated hosts allowed to connect; default any (the channels are
# public, and clients can only listen: client events are off).
REVERB_ALLOWED_ORIGINS=*
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

# More than one Reverb process: share events through Redis.
REVERB_SCALING_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

LOG_CHANNEL=stderr
LOG_LEVEL=warning
