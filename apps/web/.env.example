# Server-side base URL of the API, including any path prefix.
#   Contract mock (npm run mock):  http://localhost:4010
#   Local Laravel:                 http://localhost:8000/api/v1
API_BASE_URL=http://localhost:4010

# Public URL of this site, for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment form: "fake" shows a test form that approves or declines the hold
# through the API's fake payment mode. "moyasar" shows Moyasar's form, with
# the keys and amount the API sends (the API must use MOYASAR_DRIVER=moyasar).
NEXT_PUBLIC_PAYMENTS_MODE=fake
# The API's MOYASAR_PUBLISHABLE_KEY. The app's payment page (/payments/app)
# shows a checkout only for this key, so a shared link can never take a card
# payment for another Moyasar account. Unset, that page refuses every checkout.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
# The merchant name on the Apple Pay sheet, in English letters only.
NEXT_PUBLIC_APPLE_PAY_LABEL=Group Buy

# Live campaign progress from Laravel Reverb (apps/realtime): the app key
# (REVERB_APP_KEY, never the secret) and Reverb's public address. Unset, the
# campaign page polls the API every 5 seconds instead.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
