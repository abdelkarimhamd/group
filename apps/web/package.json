{
  "name": "@groupbuy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript ../api/openapi/v1.yaml -o src/lib/api/schema.d.ts",
    "api:types:check": "node scripts/check-api-types.mjs",
    "mock": "node scripts/mock.mjs",
    "mock:fixtures": "node mock/server.mts",
    "mock:prism": "prism mock ../api/openapi/v1.yaml -h 127.0.0.1 -p 4010"
  },
  "dependencies": {
    "moyasar-payment-form": "2.3.0",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "pusher-js": "8.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
