# Laravel Reverb (apps/realtime). ID, key and secret are the same as in api.env.
APP_NAME=GroupBuy
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (its own key, not the API's)
APP_KEY=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# The public address clients connect to (the edge ends TLS).
REVERB_HOST=ws.example.sa
REVERB_PORT=443
REVERB_SCHEME=https
# Any origin: the channels are public and clients can only listen. The
# mobile app's connections carry no website origin, so a list would shut it out.
REVERB_ALLOWED_ORIGINS=*
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

# More than one Reverb container: true, and the Redis below.
REVERB_SCALING_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

LOG_CHANNEL=stderr
LOG_LEVEL=warning
