# The customer website at runtime. Its NEXT_PUBLIC_* values are compiled into
# the image (build args in .github/workflows/images.yml), not set here.
API_BASE_URL=http://api:8000/api/v1

# Links to the site open the mobile app (docs/runbook.md, Mobile app builds).
# Unset, /.well-known/apple-app-site-association and assetlinks.json answer 404.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=sa.groupbuy.app
# SHA-256 fingerprints of the Android signing keys, separated by commas.
ANDROID_CERT_SHA256=
ANDROID_APP_PACKAGE=sa.groupbuy.app
